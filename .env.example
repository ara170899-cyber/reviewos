# ───────────────────────────────────────────────────────────────────────────
# ReviewOS · environment configuration
#
# ⚠ КРИТИЧНО: НИКОГДА не коммить файл `.env` в git. Все секреты ниже —
# плейсхолдеры. Заполняй .env реальными значениями локально, .gitignore его
# уже исключает.
#
# Если случайно запушил .env с реальными ключами — НЕМЕДЛЕННО ротируй:
#   • Anthropic → https://console.anthropic.com (revoke + новый ключ)
#   • Ozon Seller → ЛК Ozon → Настройки → API ключи (отзови + создай)
#   • Wildberries → ЛК WB → Профиль → Доступ к API (удали + создай)
#   • JWT_SECRET / DATA_ENCRYPTION_KEY → openssl rand -hex 32
# ───────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=production
PORT=3001

# CORS — на production укажи свой домен. localhost разрешён только в dev.
APP_ORIGIN=https://your-domain.example.com
ALLOWED_ORIGINS=

# Auth: длинная случайная строка, используется для подписи JWT (>32 символа)
# Генерация: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# Шифрование чувствительных данных в data/users.json (Ozon/WB/OpenRouter ключи).
# ⚠ ВНИМАНИЕ: если поменять ключ после сохранения данных — расшифровать их будет нельзя.
# Генерация: openssl rand -hex 32
DATA_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# ─── AI ─────────────────────────────────────────────────────────────────────
# AI-провайдер выбирается в Settings → 🤖 AI-провайдер. Возможны два варианта:
#
# 1) ANTHROPIC (нативный Claude SDK, быстрее, дешевле).
#    Ключ ставится ГЛОБАЛЬНО здесь — общий для всех пользователей сервиса.
#    Получить: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_REVIEW_MODEL=claude-sonnet-4-20250514

# 2) OPENROUTER (универсальный прокси к Claude / GPT-4o / Gemini / Llama / DeepSeek и др.).
#    Ключ НЕ ставится в .env — он хранится PER-USER в Settings UI (поле «OpenRouter API Key»).
#    Шифруется AES-256-GCM в data/users.json. Каждый пользователь сервиса может использовать
#    свой ключ и выбирать любую модель из списка OpenRouter.
#    Получить: https://openrouter.ai/keys
#    После того как залогинился в ReviewOS:
#      1. Открой Settings → 🤖 AI-провайдер
#      2. Выбери «OpenRouter»
#      3. Вставь ключ sk-or-v1-…
#      4. Выбери модель из дропдауна (или впиши свой model_id)
#      5. Сохрани

# ─── Rate limits и лимиты ──────────────────────────────────────────────────
JSON_LIMIT=2mb
AUTH_RATE_LIMIT_MAX=20
CYCLE_RATE_LIMIT_MAX=6

# ─── Bootstrap первого админа ──────────────────────────────────────────────
# При BOOTSTRAP_ADMIN=true и отсутствии пользователей — создаётся админ.
# Не используй на production с реальным паролем в .env — лучше `npm run reset-admin -- 'password'`.
BOOTSTRAP_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── WB public API ─────────────────────────────────────────────────────────
# Регион назначения для card.wb.ru (по умолчанию Москва).
WB_DEST=-1257786
