# ─────────────── ReviewOS · .gitignore ───────────────
# КРИТИЧНО: эти файлы содержат секреты и данные пользователей —
# они НИКОГДА не должны попасть в публичный репозиторий.

# Dependencies
node_modules/

# Environment / secrets
.env
.env.local
.env.*.local

# User data (зашифрованные API ключи, отзывы, вопросы, чаты, кэши, логи)
data/
!data/.gitkeep

# Backup / dump artefacts
*.bak
*.backup
*.dump
*.sqlite
*.sqlite-wal
*.sqlite-shm
recovery-artifacts/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Test / coverage
coverage/
.nyc_output/
